    "autoprefixer": "^10.4.19",
    "eslint": "8.57.0",
    "eslint-plugin-svelte": "^2.46.1",
    "postcss": "^8.4.38",
    "postcss-load-config": "^5.1.0",
    "sass": "^1.76.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tailwindcss": "^3.4.3",
