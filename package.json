    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "sass": "^1.76.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
